rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isCoupleMemeber(coupleId) {
      return isAuth() &&
        request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
    }

    // couples 컬렉션 — 멤버만 읽기/수정
    match /couples/{coupleId} {
      allow read: if isCoupleMemeber(coupleId);
      allow create: if isAuth() &&
        request.auth.uid in request.resource.data.members;
      allow update: if isCoupleMemeber(coupleId);
      allow delete: if false;

      // items (일정/일기/사진 등) — 멤버만 읽기/쓰기, 생성 시 createdBy 검증
      match /items/{itemId} {
        allow read: if isCoupleMemeber(coupleId);
        allow create: if isCoupleMemeber(coupleId) &&
          request.resource.data.createdBy == request.auth.uid;
        allow update: if isCoupleMemeber(coupleId);
        allow delete: if isCoupleMemeber(coupleId) &&
          resource.data.createdBy == request.auth.uid;
      }

      // messages (채팅) — 멤버만 읽기/쓰기, 생성 시 senderId 검증
      match /messages/{messageId} {
        allow read: if isCoupleMemeber(coupleId);
        allow create: if isCoupleMemeber(coupleId) &&
          request.resource.data.senderId == request.auth.uid;
        allow update: if isCoupleMemeber(coupleId);
        allow delete: if isCoupleMemeber(coupleId) &&
          resource.data.senderId == request.auth.uid;
      }
    }

    // users — FCM 토큰 저장 (본인만)
    match /users/{userId} {
      match /tokens/{tokenId} {
        allow read, write: if isAuth() && request.auth.uid == userId;
      }
    }

    // pairing — 본인 이메일 문서만 생성/삭제
    match /pairing/{email} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.token.email == email;
      allow update: if isAuth() && request.auth.token.email == email;
      allow delete: if isAuth() && request.auth.token.email == email;
    }
  }
}
